# Copy only if .env does not already exist. Never commit real credentials.
PRODUCTION_API_KEY=
# Run scripts/set-setup-password.py to create a salted hash; do not store plaintext.
SETUPS_PASSWORD_HASH=

# Set these to the private Access application's team URL and audience.
GARDIFUND_AUTH_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional. Enable the read-only port 80 listener on this PC's private IPv4.
# GARDIFUND_PRIVATE_VIEW_IP=192.168.0.175

# Optional. Defaults to the workspace's data directory.
# GARDIFUND_DATA_DIR=F:\Projects\Finance\GardiFund\data
# The launcher accepts -Port and -RemotePort for its loopback 8765/8766 listeners.
